# Gercek degerler .env dosyasinda tutulur, .env commit'lenmez.
# Yeni degisken eklenince bu dosya da guncellenir (deger degil, isim ve aciklama).

# --- nginx (tek giris kapisi) ---
# nginx'in host'ta dinledigi HTTP portu; 443'e yonlendirir. Ayni makinede
# ikinci proje calisacaksa degistir.
HTTP_PORT=80
# nginx'in host'ta dinledigi HTTPS portu; TLS burada sonlanir (ADR-066)
HTTPS_PORT=443
# TLS sertifika/anahtar dosyalarinin host'taki yolu, nginx'e salt okunur baglanir.
# Gelistirmede self-signed kullanilabilir (uretim adimlari docs/09-kurulum.md'de).
TLS_CERT_PATH=./nginx/tls/cert.pem
TLS_KEY_PATH=./nginx/tls/key.pem

# --- veritabani: sahip/backend/worker ayri rol (ADR-015) ---
POSTGRES_DB=opensicil
# sema sahibi; yalnizca migrate container'ina verilir
POSTGRES_OWNER_USER=opensicil_owner
POSTGRES_OWNER_PASSWORD=
POSTGRES_BACKEND_USER=opensicil_backend
POSTGRES_BACKEND_PASSWORD=
POSTGRES_WORKER_USER=opensicil_worker
POSTGRES_WORKER_PASSWORD=

# --- kriptografi: backend + worker (ADR-010, ADR-036, ADR-068) ---
# chacha20poly1305 ana anahtari (32 bayt, base64); kimlik no, ilk parola ve
# DB'deki AD/Zimbra/OIDC sirlari bununla sifrelenir
AEAD_MASTER_KEY=
# hmac+sha2 blind index anahtari
BLIND_INDEX_KEY=

# --- backend'e ozel ---
# disaridan gorunen adres; OIDC redirect URI ve X-Forwarded-Proto dogrulamasi
# bundan turetilir (ADR-065, ADR-061)
PUBLIC_URL=https://localhost
# metrik ucunu koruyan Bearer token (ADR-061)
METRICS_TOKEN=
# degisiklik seti esigi; asan duzenleme taslak olarak bekler (ADR-031)
CHANGE_SET_THRESHOLD=10
# tek yoneticili kurum icin onay zaman kilidi, saat; 0 = kapali (ADR-026)
APPROVAL_TIMELOCK_HOURS=0

# --- worker'a ozel ---
# acikken worker hedefe hicbir sey yazmaz, farki gosterir; ilk kurulumda
# acik baslatin (ADR-054)
DRY_RUN=true
# ilk paroladan sonra "ilk giriste degistir" (pwdLastSet 0). Ilk girisi webmail ya da
# salt okunur SSO olan personeli varsa kurum kapatir; bos = acik (ADR-019, docs/09)
FIRST_LOGIN_CHANGE_REQUIRED=true
# DC'nin LDAPS sertifikasini imzalayan CA (PEM), host'taki yol; worker'a salt
# okunur baglanir, sertifika dogrulamasi kapatilamaz (docs/05). Kurumun kok CA'si
# buraya konur; lab yolu samba-lab/tls/ca.pem (gen-tls.sh uretir, depoda yok)
AD_CA_PATH=./ad-ca.pem
# kullanici adi ve e-posta yerel kismi sablonu (ADR-011). Yer tutucular: {given}
# {given_first} {given_initial} {surname} {employee_number}; bos birakilirsa varsayilan
USERNAME_TEMPLATE={given_first}.{surname}
EMAIL_LOCAL_TEMPLATE={given_first}.{surname}
# yonetilen kapsam (ADR-014, ADR-077): worker bu kapsamin disina yazmaz, katalog
# buradan dolar. DN listeleri noktali virgulle ayrilir (DN'in kendisi virgul icerir).
# CN=Users, CN=Builtin, OU=Domain Controllers kapsam olamaz (docs/05). Faz 3a'da okunur.
AD_MANAGED_USER_OUS=
AD_PASSIVE_OU=
AD_MANAGED_GROUP_OUS=
ZIMBRA_MANAGED_DOMAINS=

# --- ortak ayarlar: backend + worker'a ayni degerle verilir (ADR-039) ---
# mevcut hesaplarin gozlem moduyla sahiplenilmesi; gecis donemi disinda kapali (ADR-018)
OWNERSHIP_MODE_ENABLED=false
# saatlik sayaclar ve acil kota; varsayilanlar kucuk kurum olcegi (docs/09 boyutlandirma)
HOURLY_DESTRUCTIVE_LIMIT=50
HOURLY_GRANT_LIMIT=50
HOURLY_FIRST_PASSWORD_LIMIT=50
EMERGENCY_QUOTA=5
# kimlik no ve telefonun hedef sisteme eslenmesi (ADR-029)
SENSITIVE_MAPPING_ENABLED=false
TZ=Europe/Istanbul
