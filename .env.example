# Burada yalnizca acilis kablolamasi var; is ayarlari (kapsam, sablonlar, kuru
# calistirma, esik, saatlik sayaclar, sahiplenme, saat dilimi...) Ayarlar ekraninda
# (ADR-131). Gercek degerler .env dosyasinda tutulur, .env commit'lenmez.
# Yeni degisken eklenince bu dosya da guncellenir (deger degil, isim ve aciklama).

# --- nginx (tek giris kapisi) ---
# nginx'in host'ta dinledigi HTTP portu; 443'e yonlendirir. Ayni makinede
# ikinci proje calisacaksa degistir.
HTTP_PORT=80
# nginx'in host'ta dinledigi HTTPS portu; TLS burada sonlanir (ADR-066)
HTTPS_PORT=443
# TLS sertifika/anahtar dosyalarinin host'taki yolu, nginx'e salt okunur baglanir.
# Gelistirmede self-signed kullanilabilir (uretim adimlari docs/09-kurulum.md'de).
TLS_CERT_PATH=./nginx/tls/cert.pem
TLS_KEY_PATH=./nginx/tls/key.pem

# --- veritabani: sahip/backend/worker ayri rol (ADR-015) ---
POSTGRES_DB=opensicil
# sema sahibi; yalnizca migrate container'ina verilir
POSTGRES_OWNER_USER=opensicil_owner
POSTGRES_OWNER_PASSWORD=
POSTGRES_BACKEND_USER=opensicil_backend
POSTGRES_BACKEND_PASSWORD=
POSTGRES_WORKER_USER=opensicil_worker
POSTGRES_WORKER_PASSWORD=

# --- kriptografi: backend + worker (ADR-010, ADR-036, ADR-068) ---
# chacha20poly1305 ana anahtari (32 bayt, base64); kimlik no, ilk parola ve
# DB'deki AD/Zimbra/OIDC sirlari bununla sifrelenir
AEAD_MASTER_KEY=
# hmac+sha2 blind index anahtari
BLIND_INDEX_KEY=

# --- backend'e ozel ---
# disaridan gorunen adres; OIDC redirect URI ve X-Forwarded-Proto dogrulamasi
# bundan turetilir (ADR-065, ADR-061)
PUBLIC_URL=https://localhost
# metrik ucunu koruyan Bearer token (ADR-061)
METRICS_TOKEN=

# --- worker'a ozel ---
# Kapsam, adlandirma sablonlari, kuru calistirma ve ilk giris ayari artik
# Ayarlar ekraninda (ADR-131); ilk kurulumda kuru calistirma acik gelir.
# DC'nin LDAPS kok CA'si da Ayarlar ekraninda, AD kartinda (ADR-136).
